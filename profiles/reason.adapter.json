{
  "adapter_schema_version": "0.1.0",
  "id": "reasonstudios.reason.windows.reference",
  "display_name": "Reason on Windows (reference adapter)",
  "status": "prototype",
  "transport": ["exchange_bundle", "vst3_client_future", "rack_extension_feasibility_future"],
  "declared_capabilities": {
    "vst3_host": true,
    "audio_import_package": true,
    "midi_import_package": true,
    "direct_project_file_write": false,
    "programmatic_track_creation": false,
    "parameter_feedback": false,
    "transport_control": false
  },
  "safe_fallback": "generate_transparent_exchange_bundle",
  "validation_required": [
    "exact Reason edition and version",
    "VST3 host capability",
    "Rack Extension distribution and sandbox feasibility",
    "audio and MIDI import behavior"
  ]
}
